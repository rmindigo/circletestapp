{
  "name": "circletestapp",
  "private": true,
  "workspaces": [
    "services/api",
    "apps/web",
    "e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w services/api",
    "dev:web": "npm run dev -w apps/web",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w services/api -w apps/web",
    "build": "npm run build --workspaces",
    "test:e2e": "npm test -w e2e"
  }
}
